# Rahnoxa Backend Server Environment Configuration

PORT=4000
NODE_ENV=development
SITE_URL=https://rahnoxa.pages.dev
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://rahnoxa.pages.dev,https://rahnoxa.com,https://www.rahnoxa.com

# Database (Supabase PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Authentication & JWT Secrets
JWT_SECRET=generate_a_random_32_character_jwt_secret_key_here
INITIAL_ADMIN_EMAIL=contact.rahnoxa@protonmail.com
INITIAL_ADMIN_PASSWORD=strong_initial_admin_password_here

# Rahnoxa Custom AI Configuration
AI_PROVIDER=rahnoxa_local
AI_BASE_URL=http://localhost:11434
AI_MODEL=rahnoxa-llama-3-8b
AI_CHAT_MODEL=rahnoxa-llama-3-8b
AI_BLOG_MODEL=rahnoxa-llama-3-8b
AI_EMBEDDING_MODEL=rahnoxa-bge-large
AI_API_KEY=
AI_TIMEOUT=30000
AI_MAX_RETRIES=2

# Automation
AUTO_PUBLISH_BLOGS=false
