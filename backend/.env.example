SUPABASE_SERVICE_ROLE_KEY=

# Authentication (Admin Security)
JWT_SECRET=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Rahnoxa Remote AI Platform
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_CHAT_MODEL=
AI_BLOG_MODEL=
AI_EMBEDDING_MODEL=
AI_API_KEY=
AI_TIMEOUT=
AI_MAX_RETRIES=

# Email Notifications
EMAIL_PROVIDER=
EMAIL_API_KEY=

# SEO Automation
AUTO_PUBLISH_BLOGS=false
