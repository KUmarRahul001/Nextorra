# =============================================================================
# Rahnoxa Platform .gitignore (Frontend + Backend + Supabase PostgreSQL)
# =============================================================================

# ── Dependencies ──
node_modules/
*/node_modules/
frontend/node_modules/
backend/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml

# ── Build & Production Outputs ──
dist/
dist-ssr/
frontend/dist/
backend/dist/
build/
*.local
out/

# ── Secrets & Environment Variables (CRITICAL) ──
# Never commit credentials, Supabase keys, JWT secrets, or DB passwords
.env
.env.*
*.env
frontend/.env
frontend/.env.*
backend/.env
backend/.env.*

# Always preserve template configuration files
!*.env.example
!frontend/.env.example
!backend/.env.example

# ── Supabase Local Development & Temporary Data ──
.supabase/
supabase/.temp/
supabase/.branches/
supabase/.env.temp

# ── Cloudflare & Wrangler Temp Files ──
.wrangler/
.mf/

# ── Logs & Debugging ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── IDE & Editor Configuration ──
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp

# ── Operating System Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ── Temporary & Cache Directories ──
tmp/
temp/
.temp/
.tmp/
.cache/
.eslintcache
.parcel-cache
