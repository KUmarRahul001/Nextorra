# ── Frontend Public Variables (VITE_ prefix exposed to browser bundle) ──
VITE_SITE_URL=https://rahnoxa.pages.dev
VITE_SITE_NAME=Rahnoxa
VITE_CONTACT_EMAIL=contact.rahnoxa@protonmail.com
VITE_CONTACT_PHONE_1=+91 8434237052
VITE_CONTACT_PHONE_2=+91 8434237049
VITE_COMPANY_LOCATION=Jharkhand, India
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/mqaqoapn
# ── Server / Cloudflare Edge Secrets (NEVER expose to frontend bundle) ──
# Set these in Cloudflare Pages Dashboard -> Settings -> Environment Variables
JWT_SECRET=YOUR_SECURE_RANDOM_HMAC_SECRET_AT_LEAST_32_CHARS
INITIAL_ADMIN_EMAIL=contact.rahnoxa@protonmail.com
INITIAL_ADMIN_PASSWORD=SET_SECURE_INITIAL_PASSWORD_HERE

# ── AI Provider & Automation Engine Settings ──
AI_PROVIDER=cloudflare_workers_ai
AI_MODEL=@cf/meta/llama-3-8b-instruct
AI_API_KEY=OPTIONAL_EXTERNAL_AI_KEY_IF_USING_GEMINI_OR_OPENAI
AUTO_PUBLISH_BLOGS=false
